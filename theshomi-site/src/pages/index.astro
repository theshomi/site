---
import '../styles/global.css';
---

<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>theshomi</title>
    <meta name="description" content="theshomi" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500&family=Playfair+Display:wght@500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main style="padding-top: 72px; padding-bottom: 40px;">
      <div class="container">
        
        <!-- Avatar -->
        <div class="avatar-wrap">
          <img src="/avatar.jpg" alt="theshomi" width="128" height="128" />
        </div>

        <!-- Name -->
        <h1 class="name serif">theshomi</h1>
        <p class="tagline">just watching</p>

        <!-- Links wall -->
        <div class="links">
          <a class="link" href="https://t.me/" target="_blank" rel="noopener">Telegram</a>
          <a class="link" href="https://github.com/" target="_blank" rel="noopener">GitHub</a>
          <a class="link" href="#" target="_blank" rel="noopener">Projects</a>
          <a class="link" href="#" target="_blank" rel="noopener">Contact</a>
        </div>

        <!-- Projects -->
        <section class="section">
          <h2 class="section-title">Selected</h2>
          <div class="projects">
            <div class="project">
              <div class="project-title">Survival Game</div>
              <div class="project-desc">Browser 3D open-world. Procedural terrain, systems, animals.</div>
            </div>
            <div class="project">
              <div class="project-title">Scripts & Bots</div>
              <div class="project-desc">Automation, P2P tools, background workers.</div>
            </div>
            <div class="project">
              <div class="project-title">Web Experiments</div>
              <div class="project-desc">Single-file apps, PWAs, small tools.</div>
            </div>
          </div>
        </section>

        <footer class="footer">
          theshomi
        </footer>
      </div>
    </main>
  </body>
</html>
